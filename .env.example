# --- Run-time selection ---
# local | copilot
LLM_BACKEND=local

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# --- Copilot / Azure OpenAI ---
# Endpoint should be the Azure OpenAI resource URL, e.g. https://<resource>.openai.azure.com
COPILOT_ENDPOINT=
COPILOT_API_KEY=
COPILOT_DEPLOYMENT=gpt-4o-mini
COPILOT_API_VERSION=2024-06-01

# --- Email (SMTP) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Pipeline knobs ---
MAX_ITEMS=12
SINCE_DAYS=7
RANKING_USE_EMBEDDINGS=false

# --- SSL / corporate proxy (Windows) ---
# Preferred: point this at your corporate root CA bundle (PEM).
# Common locations: a file your IT team provides, or %USERPROFILE%\corp-ca.pem.
CA_BUNDLE=
# Last-resort escape hatch: disable TLS verification globally. Logs a loud
# warning. Don't leave this on; use CA_BUNDLE for a real fix.
INSECURE_SSL=false
